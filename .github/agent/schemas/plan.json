{
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "target_files", "changes", "edge_cases", "acceptance_criteria", "verification", "gated", "split_required"],
  "properties": {
    "goal": { "type": "string", "maxLength": 600 },
    "target_files": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 10 },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "before", "after"],
        "properties": { "file": { "type": "string" }, "before": { "type": "string" }, "after": { "type": "string" } }
      }
    },
    "edge_cases": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "verification": { "type": "array", "items": { "type": "string" } },
    "test_gaps": { "type": "array", "items": { "type": "string" } },
    "gated": { "type": "boolean" },
    "gated_reason": { "type": "string" },
    "split_required": { "type": "boolean" },
    "sub_tickets": { "type": "array", "items": { "type": "string" } }
  }
}
